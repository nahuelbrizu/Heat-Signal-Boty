# Comparacion semanal paper (Freqtrade dry-run, en la PC desde 2026-11-18 con --local) vs backtest del laboratorio.
# Lee la base del dry-run local (~/heatsignal/data/freqtrade_dryrun.sqlite) en modo solo lectura, baja las velas que falten, re-simula y copia
# compare_<fecha>.json + paper_summary.json a ~/heatsignal/data/ (los lee GET /api/paper/compare).
# Instalar (usuario, no root):
#   cp deploy/pc/heatsignal-paper-compare.{service,timer} ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now heatsignal-paper-compare.timer
# A mano: systemctl --user start heatsignal-paper-compare.service   (o el comando de ExecStart)
# Logs:   journalctl --user -u heatsignal-paper-compare -n 100
# --since 2026-11-18: Freqtrade estuvo parado del 2026-10-25 al 2026-11-18 (VM caida); la ventana arranca cuando
# volvio a correr en la PC, asi el hueco no infla la diferencia por timing.
[Unit]
Description=HeatSignal: comparacion paper trading vs backtest (Freqtrade local en la PC, deja el resultado al panel)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/nahue/criptoBoty/heatsignal/backend
Environment=PYTHONPATH=/home/nahue/criptoBoty/heatsignal/backend/src
Environment=PATH=/snap/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/nahue/criptoBoty/heatsignal/backend/.venv/bin/python -m heatsignal.lab.paper_compare --upload --local --since 2026-11-18
Nice=10
TimeoutStartSec=2h
