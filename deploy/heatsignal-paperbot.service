# Bot propio de PAPER TRADING (lote 3 + max-ruptura-10d-v1; simulado: sin plata real ni API keys). Una corrida por hora: baja velas 1m y
# funding (REST publico de Binance), corre las reglas de params.json (lab/strategies.py) y simula fills/costos/funding en
# data/paperbot.sqlite (append-only). Ver backend/src/heatsignal/paperbot/. Lo dispara heatsignal-paperbot.timer.
# Necesita pandas en el venv (requirements-paperbot.txt); el panel y la ingesta NO lo importan.
[Unit]
Description=HeatSignal paperbot: paper trading simulado (lote 3 + max-ruptura, una corrida)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=nahue
WorkingDirectory=/home/nahue/heatsignal/backend
Environment=PYTHONPATH=/home/nahue/heatsignal/backend/src
Environment=HEATSIGNAL_HISTORY_DB=/home/nahue/heatsignal/data/heatsignal_history.sqlite
Environment=HEATSIGNAL_PAPERBOT_DB=/home/nahue/heatsignal/data/paperbot.sqlite
ExecStart=/home/nahue/heatsignal/backend/.venv/bin/python -m heatsignal.paperbot run
# Pico medido 2026-10-18 en la VM (corrida en seco, 64 dias de velas 1m x 7 simbolos + 100 dias de funding):
# 143 MB de RSS, ~5 s. El tope deja margen ~2.8x; sin swap para que un desborde falle explicito.
MemoryMax=400M
MemorySwapMax=0
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=20min
ProtectSystem=strict
ReadWritePaths=/home/nahue/heatsignal/data
PrivateTmp=true
NoNewPrivileges=true
