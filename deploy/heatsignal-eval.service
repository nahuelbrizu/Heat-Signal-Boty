# Resuelve hipotesis vencidas y evalua estrategias (Fase 3). Lo dispara heatsignal-eval.timer.
# Solo usa la base de hipotesis y klines REST de Binance: no toca datos de mercado guardados.
[Unit]
Description=HeatSignal evaluation job
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=nahue
WorkingDirectory=/home/nahue/heatsignal/backend
EnvironmentFile=-/home/nahue/heatsignal/.env
Environment=PYTHONPATH=/home/nahue/heatsignal/backend/src
Environment=HEATSIGNAL_EVAL_DB=/home/nahue/heatsignal/data/heatsignal_eval.sqlite
ExecStart=/home/nahue/heatsignal/backend/.venv/bin/python -m heatsignal.evaluation.job --public-only
MemoryMax=300M
ProtectSystem=strict
ReadWritePaths=/home/nahue/heatsignal
PrivateTmp=true
NoNewPrivileges=true
