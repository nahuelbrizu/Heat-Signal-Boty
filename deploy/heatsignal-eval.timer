# Instalar: sudo cp deploy/heatsignal-eval.{service,timer} /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now heatsignal-eval.timer
[Unit]
Description=HeatSignal evaluation job cada 5 minutos

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
Persistent=true

[Install]
WantedBy=timers.target
