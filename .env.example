# Copiar a `.env` (ignorado por git) y completar. NUNCA commitear `.env`.

# --- Postgres/TimescaleDB (docker-compose) ---
POSTGRES_USER=heatsignal
POSTGRES_PASSWORD=
POSTGRES_DB=heatsignal

# --- Ingesta (python -m heatsignal.ingestion.run) ---
# memory (default): los datos de mercado solo pasan por RAM y se descartan; no hace falta Postgres ni Redis.
# persistent: Redis + TimescaleDB (lo que usa docker-compose).
HEATSIGNAL_STORAGE=memory
HEATSIGNAL_MEM_TRADES_S=1800
HEATSIGNAL_MEM_TICKERS_S=7200
HEATSIGNAL_MEM_LIQUIDATIONS_S=86400
# Ciclo de analisis (features -> grafo -> hipotesis) dentro del proceso de ingesta. 0 lo apaga.
HEATSIGNAL_ANALYSIS_INTERVAL_S=900
HEATSIGNAL_ANALYSIS_WINDOW_S=1800
# Noticias RSS (news/feeds.py), solo en memoria 48 h; 0 las apaga
HEATSIGNAL_NEWS_INTERVAL_S=300
# Simbolos sin estrategia que el grafo analiza por turnos en cada ciclo (0 = ninguno)
HEATSIGNAL_GRAPH_ROTATION=2
# Historia privada (history/): agregados por minuto, liquidaciones, noticias; 0 la apaga
HEATSIGNAL_RECORD=1
# Respaldo diario a Drive con rclone (p.ej. gdrive: con root_folder_id = carpeta del usuario); vacio = solo VM
HEATSIGNAL_DRIVE_REMOTE=
# Sin key el ciclo solo calcula features y lo avisa. Cargarla SOLO aca (nunca en git ni en chats).
ANTHROPIC_API_KEY=
# Panel interno de solo lectura. Escucha en localhost: abrirlo con un tunel SSH, no abrir el puerto.
HEATSIGNAL_PANEL_PORT=8000

# En docker-compose REDIS_URL y DATABASE_URL se fijan en el compose; estos valores son para correr local.
# Vacios -> la ingesta avisa fuerte y cae a ConsoleSink (no persiste nada).
# Solo se usan con HEATSIGNAL_STORAGE=persistent.
REDIS_URL=
DATABASE_URL=
# ej: DATABASE_URL=postgresql://heatsignal:<password>@localhost:5433/heatsignal

HEATSIGNAL_SYMBOLS=BTCUSDT,SOLUSDT,XRPUSDT,ETHUSDT,XLMUSDT,BNBUSDT,TRXUSDT
HEATSIGNAL_EXCHANGES=binance,bybit,okx,hyperliquid
HEATSIGNAL_TICKER_INTERVAL_S=1.0
HEATSIGNAL_DB_BATCH_SIZE=500
HEATSIGNAL_DB_FLUSH_S=1.0
HEATSIGNAL_HEALTH_LOG_S=60
HEATSIGNAL_STALE_AFTER_S=30
HEATSIGNAL_LOG_LEVEL=INFO
# HEATSIGNAL_RUN_SECONDS=30   # solo para smoke tests: corre N segundos y sale

# --- Dimensionado para VM chica (e2-small, 2 GB RAM / ~30 GB disco) ---
# 2 simbolos x 3 exchanges ~ 80 trades/s (~7M filas/dia): en disco chico, trades crudos
# se guardan pocos dias y se comprimen rapido. Liquidaciones nunca se borran.
HEATSIGNAL_TRADES_RETENTION_DAYS=7
HEATSIGNAL_TICKERS_RETENTION_DAYS=30
HEATSIGNAL_COMPRESS_AFTER_DAYS=1
TS_TUNE_MEMORY=768MB
TIMESCALE_MEM_LIMIT=900m
REDIS_MAXMEMORY=150mb

# --- Contexto macro (heatsignal-macro.timer) y diario de lecciones ---
# Key GRATUITA de FRED (https://fred.stlouisfed.org/docs/api/api_key.html). Sin key FRED queda APAGADO y el panel lo dice.
FRED_API_KEY=
# HEATSIGNAL_MACRO=0     # apaga el bloque "Macro y eventos" del Analista de Contexto
# HEATSIGNAL_LESSONS=0   # apaga el diario de lecciones del job de evaluacion
