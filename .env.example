# Copiar a `.env` (ignorado por git) y completar. NUNCA commitear `.env`.

# --- Postgres/TimescaleDB (docker-compose) ---
POSTGRES_USER=heatsignal
POSTGRES_PASSWORD=
POSTGRES_DB=heatsignal

# --- Ingesta (python -m heatsignal.ingestion.run) ---
# En docker-compose REDIS_URL y DATABASE_URL se fijan en el compose; estos valores son para correr local.
# Vacios -> la ingesta avisa fuerte y cae a ConsoleSink (no persiste nada).
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=
# ej: DATABASE_URL=postgresql://heatsignal:<password>@localhost:5433/heatsignal

HEATSIGNAL_SYMBOLS=BTCUSDT,SOLUSDT
HEATSIGNAL_EXCHANGES=binance,bybit,okx
HEATSIGNAL_TICKER_INTERVAL_S=1.0
HEATSIGNAL_DB_BATCH_SIZE=500
HEATSIGNAL_DB_FLUSH_S=1.0
HEATSIGNAL_HEALTH_LOG_S=60
HEATSIGNAL_STALE_AFTER_S=30
HEATSIGNAL_LOG_LEVEL=INFO
# HEATSIGNAL_RUN_SECONDS=30   # solo para smoke tests: corre N segundos y sale

# --- Dimensionado para VM chica (e2-small, 2 GB RAM / ~30 GB disco) ---
# 2 simbolos x 3 exchanges ~ 80 trades/s (~7M filas/dia): en disco chico, trades crudos
# se guardan pocos dias y se comprimen rapido. Liquidaciones nunca se borran.
HEATSIGNAL_TRADES_RETENTION_DAYS=7
HEATSIGNAL_TICKERS_RETENTION_DAYS=30
HEATSIGNAL_COMPRESS_AFTER_DAYS=1
TS_TUNE_MEMORY=768MB
TIMESCALE_MEM_LIMIT=900m
REDIS_MAXMEMORY=150mb
