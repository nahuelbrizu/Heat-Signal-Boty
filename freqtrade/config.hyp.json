{
  "$comment": "HeatSignal - hipotesis de 1h del grafo ejecutadas en Freqtrade DRY-RUN (dinero simulado, precios reales, sin API keys). Segunda instancia, separada del bot de Donchian: base data/freqtrade_hyp.sqlite, API 127.0.0.1:8082 (en config.hyp.secrets.json, generado en la VM y fuera de git). Sin senales propias: entra solo por forceenter del puente (heatsignal.paper.ft_bridge) y sale por tiempo (custom_exit).",
  "strategy": "HypothesisBridgeV1",
  "dry_run": true,
  "dry_run_wallet": 10000,
  "stake_currency": "USDT",
  "stake_amount": 1000,
  "tradable_balance_ratio": 0.99,
  "max_open_trades": 7,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "timeframe": "1h",
  "force_entry_enable": true,
  "cancel_open_orders_on_exit": false,
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "order_types": {
    "entry": "market",
    "exit": "market",
    "force_entry": "market",
    "force_exit": "market",
    "stoploss": "market",
    "stoploss_on_exchange": false
  },
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "pair_whitelist": [
      "BTC/USDT:USDT",
      "SOL/USDT:USDT",
      "XRP/USDT:USDT",
      "ETH/USDT:USDT",
      "XLM/USDT:USDT",
      "BNB/USDT:USDT",
      "TRX/USDT:USDT"
    ]
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "bot_name": "heatsignal-hipotesis",
  "initial_state": "running",
  "internals": {
    "process_throttle_secs": 60
  }
}
