{
  "$comment": "HeatSignal - donchian-ensemble-v1 en DRY-RUN (dinero simulado, precios reales, sin API keys). El api_server (FreqUI) va en config.secrets.json, que solo existe en la VM (fuera de git).",
  "strategy": "DonchianEnsembleV1",
  "dry_run": true,
  "dry_run_wallet": 10000,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.99,
  "max_open_trades": 7,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "timeframe": "4h",
  "cancel_open_orders_on_exit": false,
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "order_types": {
    "entry": "market",
    "exit": "market",
    "stoploss": "market",
    "stoploss_on_exchange": false
  },
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "pair_whitelist": [
      "BTC/USDT:USDT",
      "SOL/USDT:USDT",
      "XRP/USDT:USDT",
      "ETH/USDT:USDT",
      "XLM/USDT:USDT",
      "BNB/USDT:USDT",
      "TRX/USDT:USDT"
    ]
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "bot_name": "heatsignal-donchian",
  "initial_state": "running",
  "internals": {
    "process_throttle_secs": 30
  }
}
